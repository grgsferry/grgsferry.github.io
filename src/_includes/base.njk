<!DOCTYPE html>
<html lang="en" style="overflow-y: scroll">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} - {% endif %}Gregorius Ferry</title>
    <link rel="stylesheet" href="/style.css" />
    <!-- <link rel="icon" href="/favicon.svg" /> -->
  </head>
  <body>
    <main>
      <header class="site-header">
        <p class="site-name">Gregorius Ferry</p>
        <p>{% for item in nav %}{% if item.section == section %}<b>{{ item.title }}</b>{% else %}<a href="{{ item.url }}">{{ item.title }}</a>{% endif %}{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
      </header>
      <hr />

      {{ content | safe }}

      <hr />
      <p>
        <small>Gregorius Ferry &middot; <a href="mailto:grgsferry@gmail.com">Email</a> &middot; <a href="https://www.linkedin.com/in/gregoriusferry/">LinkedIn</a> &middot; <a href="https://github.com/grgsferry">GitHub</a></small>
      </p>
    </main>
  </body>
</html>
